[Unit]
Description=Tişört Atölyesi herkese açık demo
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/opt/tisort
# Meta anahtarı Yorum demosuyla aynı ortam dosyasından okunur
EnvironmentFile=/etc/yorum-demo.env
ExecStart=/usr/bin/python3 canli.py
Restart=always
RestartSec=5
MemoryMax=400M
CPUQuota=60%
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/tisort/kayitlar /opt/tisort/cikti /opt/tisort/veri
PrivateTmp=true

[Install]
WantedBy=multi-user.target
